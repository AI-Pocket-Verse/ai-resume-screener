# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
*.tsbuildinfo
coverage/

# Env — only the .example template is committed
.env
.env.*
!.env.example

# Runtime data: uploads and databases (contain resumes and personal data).
# Ignored everywhere, not just in api/, so copies and backups never get committed.
api/data/
api/data-test/
*.db
*.db-*
*.sqlite*
*.bak

# Resume files — real resumes must never be committed (demo data is plain text).
# Allow a specific file with a `!path` rule if one is ever needed.
*.pdf
*.docx

# Generated Prisma client (`pnpm install` regenerates it)
api/generated/

# Logs (may contain resume excerpts) and certificates / keys
*.log
*.pem
*.key
*.p12

# Editor / OS
.vscode/
.idea/
.DS_Store
*.swp

# Private notes, scratch files, internal workflow docs
.private/
.tmp/
goals/
process/
ROADMAP.md

# AI tool instructions and local config
AGENTS.md
CLAUDE.md
.claude/
.codex/
.cursor/
.mcp.json
.playwright-mcp/

# eval-regress.mts 的基线快照，含候选人姓名
eval-baseline.json
