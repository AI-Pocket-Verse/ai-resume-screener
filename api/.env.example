# ai-resume-screener API — copy to .env.dev (local) or .env.prod (server) and
# adjust. Loaded via Node's native --env-file= flag. Never commit the copies.
# (No inline comments after values: older Node versions read them as part of the value.)

NODE_ENV=development
PORT=4070
# Local mode has no login and resumes contain personal data: keep 127.0.0.1
# unless WHOAMI_URL below is set.
HOST=127.0.0.1
# Reverse proxies whose X-Forwarded-For is trusted (Fastify trustProxy), so the
# rate limit buckets by the real client IP. Default loopback = same-host nginx.
# Do not set it to true: any client could then spoof its IP. Hop counts (plain
# numbers) are rejected: Fastify no longer supports them.
# TRUST_PROXY=loopback

# Browser origin of the web app, for the CORS allowlist.
WEB_ORIGIN=http://localhost:5070

# SQLite (Prisma). A relative file: path resolves against api/prisma/, so this
# lands at api/prisma/dev.db (gitignored). Prod: use an ABSOLUTE path.
DATABASE_URL=file:./dev.db

# Uploaded originals and rendered page images. Relative to api/.
DATA_DIR=./data

# ── Login (optional) ────────────────────────────────────────────────
# Unset = local single-user mode: no login, the single local user is the
# super admin. To require Feishu login, deploy feishu-sso
# (https://github.com/AI-Pocket-Verse/feishu-sso) and point this at its whoami endpoint
# (web must also set VITE_SSO_BASE).
# WHOAMI_URL=http://127.0.0.1:4020/api/whoami
# Super admins once login is on: comma-separated mobile numbers. They see every
# job, can permanently delete candidates and read the audit log.
# ADMIN_MOBILES=13800138000
# With NODE_ENV=production the api refuses to start without WHOAMI_URL, because
# everyone who can reach the site would be a super admin. Set this to true only
# if access is already protected another way.
# ALLOW_NO_AUTH=false

# ── Feishu notifications (optional) ─────────────────────────────────
# Sends a card to the uploader when a parse / evaluation batch finishes. Needs
# feishu-sso: AUTH_API_BASE is its API base, INTERNAL_API_TOKEN must equal the
# INTERNAL_API_TOKEN in feishu-sso's env. Leave both unset to disable.
# AUTH_API_BASE=http://127.0.0.1:4020/api
# INTERNAL_API_TOKEN=
# Public URL of the web app, used for the link inside notification cards.
WEB_PUBLIC_URL=http://localhost:5070

# ── LLM ─────────────────────────────────────────────────────────────
# Channel (provider) and model per purpose. LLM_PROVIDER / LLM_MODEL apply to all
# three purposes; LLM_PARSE_* / LLM_SCREEN_* / LLM_DEEP_* override one purpose:
# parse (resume → structured data, PDF / images need a VISION model),
# screen (quick grade, batch), deep (full evaluation, one at a time).
#
# Providers:
#   claude     Claude Code CLI on this machine (default). Install it and log in
#              once as the user that runs this service. LLM_MODEL is optional
#              (e.g. opus / sonnet); empty = the CLI's default model.
#   anthropic  Anthropic API. Needs ANTHROPIC_API_KEY; default model claude-opus-5-5.
#   openai     OpenAI API, or any OpenAI-compatible server via OPENAI_BASE_URL
#              (e.g. Ollama at http://127.0.0.1:11434/v1, key optional then).
#   doubao / qwen / deepseek / zhipu / kimi / minimax
#              OpenAI-compatible presets; need the matching *_API_KEY below.
# Every provider except claude / anthropic needs a model name.
# A config error (unknown provider, missing key or model) stops the api at startup.
LLM_PROVIDER=claude
# LLM_MODEL=
# Example: vision model for parsing, cheaper model for batch screening.
# LLM_PARSE_PROVIDER=qwen
# LLM_PARSE_MODEL=qwen-vl-max
# LLM_SCREEN_PROVIDER=deepseek
# LLM_SCREEN_MODEL=deepseek-chat
# LLM_DEEP_PROVIDER=anthropic
# LLM_DEEP_MODEL=claude-opus-5-5

# Path to the claude CLI. Leave unset to find `claude` on PATH.
# CLAUDE_BIN=/usr/local/bin/claude

# Keys / endpoints. Only the providers you select need them.
# Note: ANTHROPIC_* variables are also passed to the claude CLI, so setting
# ANTHROPIC_API_KEY makes the claude provider bill that key too.
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# ARK_API_KEY=
# QWEN_API_KEY=
# DEEPSEEK_API_KEY=
# ZHIPU_API_KEY=
# KIMI_API_KEY=
# MINIMAX_API_KEY=

# Optional LLM call tuning (milliseconds / effort level). Must be plain numbers;
# a non-numeric value times calls out at once. LLM_EFFORT (low / medium / high /
# xhigh / max) applies to the claude and anthropic providers; deep evaluation
# always asks for high.
# LLM_IDLE_TIMEOUT_MS=90000
# LLM_HARD_TIMEOUT_MS=600000
# LLM_EFFORT=

# ── PDF rendering (poppler) ─────────────────────────────────────────
# Needs poppler (the pdfinfo and pdftocairo commands): macOS `brew install poppler`, Debian `apt install poppler-utils`.
# Servers also need CJK fonts (Debian `fonts-noto-cjk`), or Chinese resumes
# render as boxes.
RESUME_RENDER_LONG_EDGE=2200
RESUME_MAX_PAGES=20
RESUME_RENDER_TIMEOUT_MS=60000
